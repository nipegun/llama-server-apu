#!/sbin/openrc-run

name="llama-server-apu"
description="llama-server-apu for x86-64 APUs"
command="@PREFIX@/bin/llama-server-apu"
command_args="--model /opt/llama-server-apu/models/model.gguf --host 127.0.0.1 --port 18080 --api-prefix /api --api-key-file /opt/llama-server-apu/config/api-key.txt"
command_user="llama-server-apu:llama-server-apu"
directory="/opt/llama-server-apu"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/llama-server-apu.log"
error_log="/var/log/llama-server-apu.log"
export XDG_CACHE_HOME="/opt/llama-server-apu/cache"

depend() {
  need net
}
